# Chaperone configuration. Copy to .env and fill in what you need.
# `pnpm demo:dry` needs NONE of this: it runs on a local sandbox with generated keys.

# --- Network ---------------------------------------------------------------
# sandbox | testnet | mainnet. The demos use testnet only when this is "testnet".
NEAR_NETWORK=testnet
# Defaults to https://test.rpc.fastnear.com for testnet.
NEAR_RPC_URL=

# --- Vault (testnet) --------------------------------------------------------
# The account that holds the contract and the USDC. Agents sign as this account.
VAULT_ID=
# A different account with a full-access key: approves warn requests, edits policy.
OWNER_ID=
# Optional: otherwise read from ~/.near-credentials/testnet/$OWNER_ID.json
OWNER_PRIVATE_KEY=
# Circle USDC on NEAR testnet (6 decimals). Leave empty for this default.
USDC_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
# Allowlisted vendor, and the account the poisoned page tries to pay.
VENDOR_ID=
ATTACKER_ID=
# Policy at deploy time (USDC, whole units) and USDC to move into the vault in setup.
DAILY_CAP_USDC=100
PER_TX_CAP_USDC=50
TIMELOCK_MS=86400000
FUND_USDC=0

# --- Agents (written by `pnpm setup:testnet` to .chaperone/testnet-agents.env) ---
AGENT_BUYER_PRIVATE_KEY=
AGENT_RESEARCHER_PRIVATE_KEY=

# --- Checker ----------------------------------------------------------------
# `pnpm keygen` prints both. The public key is stored in the vault at init.
CHECKER_SECRET_KEY=
CHECKER_PUBLIC_KEY=
# If set, the demos call this checker instead of starting one in-process.
CHECKER_URL=
CHECKER_HOST=127.0.0.1
CHECKER_PORT=8787
VERDICT_TTL_MS=120000
# Blocklist: a JSON file, and/or a Supabase table `blocklist(account_id, reason, evidence, reported_at)`.
BLOCKLIST_PATH=fixtures/blocklist.json
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: account age and tx count from NearBlocks instead of the RPC key-nonce estimate.
NEARBLOCKS_API_KEY=
NEARBLOCKS_API_URL=

# --- Agent brain (optional; without a key a scripted agent makes the same tool calls) ---
# NEAR AI Cloud (OpenAI-compatible) takes precedence when set.
NEAR_AI_API_KEY=
# Default is TEE-attested: the agent checks the model's attestation before acting.
NEAR_AI_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Force the scripted agent even when a key is set.
CHAPERONE_SCRIPTED_AGENT=

# --- NEAR Intents (pnpm demo:swap, dry quotes only) ---
# A mainnet account to stand in for the vault in 1Click dry quotes. Nothing is deposited or sent.
SWAP_MAINNET_ACCOUNT=
